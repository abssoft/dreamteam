{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-team.invalid/contracts/assignment-v1.schema.json",
  "title": "DreamTeam Assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "assignment_id", "role", "objective", "scope"],
  "properties": {
    "contract_version": {"const": 1},
    "assignment_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "repository": {"type": "object"},
    "verification": {"type": "array", "items": {"type": "string"}},
    "required_fixes": {"type": "array", "items": {"type": "string"}},
    "accepted_decisions": {"type": "array", "items": {"type": "string"}},
    "source_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "content", "provenance"],
        "properties": {
          "kind": {"enum": ["text", "repository_evidence", "attachment_reference"]},
          "name": {"type": "string"},
          "content": {"type": "string"},
          "provenance": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
